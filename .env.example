# Puerto del servidor. Railway lo inyecta automáticamente (PORT).
PORT=3000

# Ruta del archivo SQLite de la base de datos.
# En Railway: apunta a un volumen persistente, p. ej. /data/club.db
DB_PATH=./data/club.db

# Habilita las rutas de desarrollo "spike" (WebRTC de prueba).
# Mantener en 0 en producción.
ENABLE_SPIKE=0
